#!/bin/bash
# ---x200T settings---
xsetwacom set "Serial Wacom Tablet WACf00c stylus" Area 210 116 26320 16440
xsetwacom set "Serial Wacom Tablet WACf00c eraser" Area 210 116 26320 16440

xsetwacom set "Serial Wacom Tablet WACf00c stylus" Threshold 500
#lmao this isnt enough
xsetwacom set "Serial Wacom Tablet WACf00c eraser" Threshold 200

# Attempt to fix touchscreen jitter
#xsetwacom --set "Serial Wacom Tablet WACf00c touch" Suppress 10
#xsetwacom --set "Serial Wacom Tablet WACf00c touch" RawSample 16

# ---x230T settings---
xsetwacom set "Wacom ISDv4 E6 Pen stylus" Area 186 -2 27715 15542
xsetwacom set "Wacom ISDv4 E6 Pen eraser" Area 130 119 27700 15594

xsetwacom set "Wacom ISDv4 E6 Pen eraser" Threshold 200
